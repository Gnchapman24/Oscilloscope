# Main FPGA Clock
set_io clk 15

# 7 Segment 1 (Ones)
set_io svseg_1[6] 100
set_io svseg_1[5] 99
set_io svseg_1[4] 97
set_io svseg_1[3] 95
set_io svseg_1[2] 94
set_io svseg_1[1] 8
set_io svseg_1[0] 96

# 7 Segment 2 (Tens)
set_io svseg_2[6] 3
set_io svseg_2[5] 4
set_io svseg_2[4] 93
set_io svseg_2[3] 91
set_io svseg_2[2] 90
set_io svseg_2[1] 1
set_io svseg_2[0] 2